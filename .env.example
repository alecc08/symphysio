# Copy to .env and feed to your runner/compose (docker-compose.yml sets these
# itself; this file documents the full set). The app reads environment
# variables only — there is no config file and nothing secret is committed.

# Where the SQLite database lives. Must be writable; nothing else is.
SYPHYSIO_DATA_DIR=./data
SYPHYSIO_DB_PATH=./data/symphysio.sqlite

# Compiled SPA location (the image bakes this to /app/static).
SYPHYSIO_STATIC_DIR=../frontend/dist

# Where forward-only .sql migrations are found.
SYPHYSIO_MIGRATIONS_DIR=./migrations

# Session cookie. Keep 1 in production (HTTPS); set 0 only for plain-HTTP dev
# on a non-localhost origin.
SYPHYSIO_COOKIE_SECURE=1
SYPHYSIO_SESSION_TTL_DAYS=30

# Auth endpoint rate limiting (per process — run a single worker).
SYPHYSIO_RATE_LIMIT=1
SYPHYSIO_RATE_LIMIT_ATTEMPTS=10
SYPHYSIO_RATE_LIMIT_WINDOW=900
SYPHYSIO_RATE_LIMIT_LOCKOUT=900

# Reject request bodies larger than this many bytes.
SYPHYSIO_MAX_BODY_BYTES=262144

# Where your reverse proxy is, as CIDRs (space or comma separated). The client
# address the auth limiter keys on is the socket peer UNLESS that peer is one of
# these; only then is X-Forwarded-For believed, down to the right-most entry that
# is not itself a proxy of ours. Empty (default) = no proxy: correct for
# `uv run uvicorn` on a laptop. Behind Traefik on Docker, name the compose network
# traefik connects from — not the whole LAN, which would let any device forge its
# address and guess without limit.
SYPHYSIO_TRUSTED_PROXIES=

# Sign-up. Open by default, because the first account has to come from
# somewhere. Set 0 once your own accounts exist — required advice for anything
# the internet can reach (docs/DEPLOYING.md). Closed means POST
# /api/v1/auth/register answers 403, and the attempt still costs the caller its
# rate-limit budget.
SYPHYSIO_ALLOW_REGISTRATION=1

# Email confirmation. Optional: with none of these set, mail is switched off,
# accounts are born confirmed, and nothing else changes. The key, the sender and
# the public URL all have to be set before a link can be built. See
# docs/DEPLOYING.md for the Resend domain/SPF/DKIM setup.
RESEND_API_KEY=
SYPHYSIO_EMAIL_FROM=Symphysio <confirm@mail.example.org>
SYPHYSIO_EMAIL_REPLY_TO=
# Absolute origin your phone can reach. The link host always comes from here,
# never from the request's Host header.
SYPHYSIO_PUBLIC_URL=https://symphysio.example.org
# resend | outbox (write .eml files under DATA_DIR/outbox, never send) | null.
# Defaults to resend when configured, null otherwise.
SYPHYSIO_MAIL_BACKEND=
SYPHYSIO_EMAIL_TTL_SECONDS=86400
SYPHYSIO_EMAIL_SENDS_PER_HOUR=3
# off | optional | required — how much this instance asks about email.
#   optional (default): mail a link, show a reminder banner, never block anyone.
#   required:           sign-in is blocked until the link is clicked. Refuses to
#                       start with no mail transport: a gate nobody can pass is a
#                       bug, not a policy.
#   off:                no confirmation mail at all, no banner, no gate. Even if
#                       a transport is configured for other reasons.
SYPHYSIO_EMAIL_CONFIRMATION=optional
